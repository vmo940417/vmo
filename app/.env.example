# 이 파일을 .env 로 복사해서 값을 채우세요.   cp .env.example .env

# Claude API 키. 없으면 규칙 기반 분석만 동작합니다(앱은 그대로 돌아갑니다).
# 발급: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# 판단 엔진 모델.
#   claude-sonnet-5  (기본) — 장중 즉답용. 빠릅니다.
#   claude-opus-5           — 더 깊은 판단이 필요할 때. 느립니다.
STOCKWHY_MODEL=claude-sonnet-5

# 접근 잠금. 설정하면 /api 호출에 이 토큰이 필요합니다.
#   - 집 와이파이나 Tailscale 처럼 사설망이면 비워두세요.
#   - 공개 터널(trycloudflare 등)로 열 거라면 반드시 설정하세요.
#     URL 을 아는 사람이 곧 내 Claude API 크레딧을 쓸 수 있는 사람이 됩니다.
#   아무 긴 문자열이면 됩니다:  python -c "import secrets;print(secrets.token_urlsafe(24))"
STOCKWHY_TOKEN=

# 비용 표시용 환율 (원/달러). 청구액이 아니라 감을 잡기 위한 근사값입니다.
# STOCKWHY_USD_KRW=1400

# 사용량 기록 파일 경로. 기본은 app/.usage.jsonl 입니다.
# STOCKWHY_USAGE_LOG=

# --- KRX 개별종목 공매도 (선택, "pip install -r requirements.txt" 로 소스에서
#     직접 실행할 때만 동작 — 배포되는 stockwhy.exe 에는 안 들어있습니다) -------
# KRX Data Marketplace 가 개편되면서, 개별종목 공매도(MDCSTAT30001)는 로그인
# 세션 없이는 무조건 400(LOGOUT)을 줍니다. 본인 KRX Data Marketplace 로그인
# 계정을 등록하면 이 데이터만 채워집니다 — 없어도 나머지 분석(시세·뉴스·수급 등)
# 은 그대로 동작합니다.
#
# 주의:
#  - stockwhy.exe(배포용)에는 pykrx(및 pandas/numpy)가 일부러 빠져 있습니다.
#    한 번 넣어봤다가, VC++ 런타임이 없는 PC에서 exe 가 더블클릭해도 아무
#    반응 없이 죽는 문제가 있어 되돌렸습니다. 여기 계정을 넣어도 exe 에서는
#    적용되지 않고 조용히 무시됩니다 — 쓰려면 소스에서 직접 실행하세요.
#  - 자동 로그인·수집이 KRX 약관상 명시적으로 허용되는지 확인되지 않았습니다.
#    계정 제재 위험을 감수하는 선택입니다. 비밀번호는 반드시 이 파일(환경변수)
#    로만 관리하고 코드에 직접 쓰지 마세요.
# KRX_ID=
# KRX_PW=

# --- 회사망(TLS 검사 장비) 대응 ---------------------------------------------
# 기본적으로 truststore 가 설치돼 있으면 OS 인증서 저장소를 자동으로 씁니다.
# 보통 아래 두 줄은 건드릴 필요가 없습니다.
#
# truststore 로도 안 될 때만, 회사 루트 인증서를 .pem 으로 내보내 경로를 지정:
# STOCKWHY_CA_BUNDLE=C:\path\to\company-root.pem
#
# OS 저장소를 쓰지 않고 기존 방식(certifi)으로 되돌리려면:
# STOCKWHY_TLS=certifi
